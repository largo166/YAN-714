# ROM-AI 预置 key 分发模板(开箱即用)
# ─────────────────────────────────────────────────────────────
# 用法:把本文件复制为同目录下的 .env.bundle,填入「分发专用」key,再 build exe。
#   cp desktop/.env.bundle.example desktop/.env.bundle   # 然后编辑填 key
# .env.bundle 不入 git(.gitignore 的 .env.* 已忽略),但会被打进 exe。
#
# ⚠️ 安全告知:exe 可被解包,这里的 key 会随每个副本泄露给拿到 exe 的人。
#   → 强烈建议用「专用、可随时吊销、限额」的 key,不要用你的主 key。
#   → 只发可信范围;换 key 需重新 build 重发。
#
# 注入方式(首启空库时一次性):
#   - DEEPSEEK_API_KEY → 写进 DB AppSetting.deepseek_api_key(AI 文字三件套读这里)
#   - IMAGE_API_KEY / ASR_API_KEY → 复制到 %LOCALAPPDATA%/ROM-AI/.env(config 读这里)
# 不预置某项就留空,收件人可在设置页/.env 自填。

# ── DeepSeek(AI 研判/会议纪要/对话/认知抽取)──
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ── AI 生图(APImart,OpenAI 兼容)──
IMAGE_API_KEY=
IMAGE_BASE_URL=https://api.apimart.ai
IMAGE_MODEL=gpt-image-1-official

# ── 语音转写 ASR(可选)──
ASR_PROVIDER=
ASR_API_KEY=
ASR_API_URL=
ASR_MODEL=
