# ROM-AI 后端环境变量（本地开发用；切勿写入真实密钥）
HOST=127.0.0.1
PORT=8000

# SQLite 数据库；留空则默认 backend/data/rom_ai.db（与运行目录无关）
DATABASE_URL=

# 允许的前端来源（CORS，逗号分隔）
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# 公网访问闸（公网部署必须开启；口令/会话密钥只写部署机 .env，不进 git）
ACCESS_CONTROL_ENABLED=false
ACCESS_PASSWORD=
ACCESS_SESSION_SECRET=
ACCESS_SESSION_HOURS=12
ACCESS_COOKIE_SECURE=false

# DeepSeek（可选，未配置则走 mock；不要提交真实 key）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ── 腾讯会议 provider（可选；token 只进本机，勿提交真实值）──
# 运行时 token 通常放本机 ~/.claude/settings.json 的 env (TENCENT_MEETING_TOKEN)，也可在此配。
# skill 脚本目录留空则按默认 ~/.claude/skills/tencent-meeting-mcp/scripts 探测。
TENCENT_MEETING_TOKEN=
TENCENT_MEETING_SKILL_DIR=

# ── ASR 录音转写（会议模块，可选；key 只进本机，勿提交）──
# ASR_PROVIDER 留空则按 key 自动选；可选 openai|mimo|custom
ASR_PROVIDER=
ASR_API_KEY=
ASR_API_URL=
ASR_MODEL=
ASR_LANGUAGE=zh

# ── 成果发送渠道（仅预览，不真实外发）──
RESULT_SEND_EMAIL_CONFIGURED=false
RESULT_SEND_WECOM_CONFIGURED=false
RESULT_SEND_WX_CONFIGURED=false
